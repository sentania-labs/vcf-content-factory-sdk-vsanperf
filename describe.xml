<?xml version="1.0" encoding="UTF-8"?>
<!--
  describe.xml: VCF Content Factory vSAN Performance (vcfcf_vsanperf).

  The pak creates its adapter instance (type 7) and, since build 7, one
  "VCF Content Factory vSAN Performance Collector" object per instance: the
  platform does not list the adapter instance among the resources it
  collects, so the cycle runs in collect() for that object, and an
  unreachable vCenter shows the account DOWN. The vSAN
  metrics land on the vCenter adapter's own VMWARE HostSystem,
  ClusterComputeResource (since build 10) and VirtualMachine (since build 11)
  objects through the Suite API (ARIA_OPS stitching), so they are not declared here:
  a pak cannot declare keys for VMWARE kinds, and pushed keys carry no label
  or unit (the unit is in the key leaf instead). Key reference: REFERENCE.md.
  Design: factory knowledge/designs/vsanperf-mp-v1.md and, from build 10,
  vsanperf-mp-v2.md (host, cluster, disk and VM tiers); from build 19,
  vsanperf-mp-v3.md (metric_scope).

  Identity: vcenter_host and cluster_include (identType 1), so shard
  instances against one vCenter are distinct accounts (design Q3).
  Everything else is identType 2 with a default (Advanced Settings).
  Changing a field's identType after release changes account identity.

  No TraversalSpecKind: there is no object tree of this pak's own.
-->
<AdapterKind xmlns="http://schemas.vmware.com/vcops/schema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             key="vcfcf_vsanperf"
             nameKey="1"
             version="1"
             xsi:schemaLocation="http://schemas.vmware.com/vcops/schema describeSchema.xsd">

	<CredentialKinds>
		<CredentialKind key="vcenter_credentials" nameKey="2">
			<CredentialField key="username" nameKey="3" type="string" required="true" dispOrder="1"/>
			<CredentialField key="password" nameKey="4" type="string" required="true" password="true" dispOrder="2"/>
		</CredentialKind>
	</CredentialKinds>

	<ResourceKinds>

		<!-- Adapter instance. monitoringInterval 5 = the Performance
		     Service's native 300 s bucket; the cycle deadline defaults to
		     the interval minus 60 s. -->
		<ResourceKind key="vcfcf_vsanperf" nameKey="5" type="7"
		              credentialKind="vcenter_credentials"
		              monitoringInterval="5">
			<ResourceIdentifier key="vcenter_host" nameKey="6" type="string"
			                    required="true" dispOrder="1"/>
			<ResourceIdentifier key="cluster_include" nameKey="7" type="string"
			                    required="false" dispOrder="2" default="" identType="1"/>
			<ResourceIdentifier key="cluster_exclude" nameKey="8" type="string"
			                    required="false" dispOrder="3" default="" identType="2"/>
			<ResourceIdentifier key="max_parallel_clusters" nameKey="9" type="string"
			                    required="false" dispOrder="4" default="4" identType="2"/>
			<ResourceIdentifier key="call_timeout_seconds" nameKey="10" type="string"
			                    required="false" dispOrder="5" default="30" identType="2"/>
			<ResourceIdentifier key="cycle_deadline_seconds" nameKey="11" type="string"
			                    required="false" dispOrder="6" default="0" identType="2"/>
			<ResourceIdentifier key="perf_timing_logging" nameKey="12" type="string"
			                    required="false" dispOrder="7" default="false" identType="2"
			                    enum="true">
				<enum value="false" displayOrder="1"/>
				<enum value="true" displayOrder="2"/>
			</ResourceIdentifier>
			<!-- Build 10 (design v2 "Settings"): tiers beyond the always-on
			     core. An account saved before build 10 has no stored value and
			     gets the default (on). identType 2: not part of identity. -->
			<ResourceIdentifier key="tier_host" nameKey="13" type="string"
			                    required="false" dispOrder="8" default="true" identType="2"
			                    enum="true">
				<enum value="true" displayOrder="1"/>
				<enum value="false" displayOrder="2"/>
			</ResourceIdentifier>
			<ResourceIdentifier key="tier_cluster" nameKey="14" type="string"
			                    required="false" dispOrder="9" default="true" identType="2"
			                    enum="true">
				<enum value="true" displayOrder="1"/>
				<enum value="false" displayOrder="2"/>
			</ResourceIdentifier>
			<ResourceIdentifier key="exclude_types" nameKey="15" type="string"
			                    required="false" dispOrder="10" default="" identType="2"/>
			<!-- Build 11 (design v2 "Settings"): the disk and VM tiers, off by
			     default; the VM tier's cadence (1 to 12, staggered per cluster). -->
			<ResourceIdentifier key="tier_disk" nameKey="16" type="string"
			                    required="false" dispOrder="11" default="false" identType="2"
			                    enum="true">
				<enum value="false" displayOrder="1"/>
				<enum value="true" displayOrder="2"/>
			</ResourceIdentifier>
			<ResourceIdentifier key="tier_vm" nameKey="17" type="string"
			                    required="false" dispOrder="12" default="false" identType="2"
			                    enum="true">
				<enum value="false" displayOrder="1"/>
				<enum value="true" displayOrder="2"/>
			</ResourceIdentifier>
			<ResourceIdentifier key="vm_tier_every_n_cycles" nameKey="18" type="string"
			                    required="false" dispOrder="13" default="3" identType="2"/>
			<!-- Build 19 (design v3 "Setting: metric_scope"): dashboard (the
			     451 keys the Python pack's views use, unchanged behaviour) or
			     all (every catalog key of the 69 entity types, no labels
			     filter). An account saved before 1.2.0 has no stored value and
			     gets dashboard. identType 2: not part of identity. -->
			<ResourceIdentifier key="metric_scope" nameKey="43" type="string"
			                    required="false" dispOrder="14" default="dashboard" identType="2"
			                    enum="true">
				<enum value="dashboard" displayOrder="1"/>
				<enum value="all" displayOrder="2"/>
			</ResourceIdentifier>

			<!-- Self-metrics (design Q4), delivered in the collect result. -->
			<ResourceGroup key="Collection" nameKey="20" instanced="false">
				<ResourceAttribute key="clusters_in_scope" nameKey="21" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="clusters_ok" nameKey="22" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="clusters_failed" nameKey="23" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="clusters_timed_out" nameKey="24" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="perf_calls" nameKey="25" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="series_pushed" nameKey="26" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="hosts_unresolved" nameKey="27" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="push_batches_failed" nameKey="28" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="cycle_seconds" nameKey="29" dataType="float"
				                   isProperty="false" defaultMonitored="true" unit="sec"/>
				<ResourceAttribute key="perf_calls_per_second" nameKey="30" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="perf_call_ms_avg" nameKey="31" dataType="float"
				                   isProperty="false" defaultMonitored="true" unit="ms"/>
				<ResourceAttribute key="last_error" nameKey="32" dataType="string"
				                   isProperty="true"/>
				<!-- Build 10 (design v2). -->
				<ResourceAttribute key="clusters_unresolved" nameKey="33" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="entities_unparsed" nameKey="34" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<!-- Build 11 (design v2; review W1). -->
				<ResourceAttribute key="disks_unresolved" nameKey="35" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="vms_unresolved" nameKey="36" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="vdisks_unresolved" nameKey="37" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="optional_calls_failed" nameKey="38" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<!-- 1.2.1 (factory design vsanperf-mp-v3 "1.2.1", D2 and D8). -->
				<ResourceAttribute key="clusters_perfsvc_disabled" nameKey="44" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
				<ResourceAttribute key="required_calls_failed" nameKey="45" dataType="float"
				                   isProperty="false" defaultMonitored="true"/>
			</ResourceGroup>
		</ResourceKind>

		<!-- Build 7: the per-instance object the cycle runs for. Identity
		     is the account's own (vCenter Server and Clusters to include
		     exactly as stored, trimmed only, * when empty; build 8),
		     known without a login, so it exists
		     while vCenter is unreachable. No metrics: the self-metrics stay
		     on the adapter instance. -->
		<ResourceKind key="VsanPerfCollector" nameKey="40" type="1">
			<ResourceIdentifier key="vcenter" nameKey="41" type="string"
			                    required="true" dispOrder="1"/>
			<ResourceIdentifier key="cluster_scope" nameKey="42" type="string"
			                    required="true" dispOrder="2"/>
		</ResourceKind>

	</ResourceKinds>

	<LicenseConfig enabled="false"/>

</AdapterKind>
